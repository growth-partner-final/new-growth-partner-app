# ============================================================================
# Nexora Growth Partner — example environment configuration (NO real secrets)
# ============================================================================
#
# HARD RULES (enforced by src/env.ts + contract tests):
#   1. The Supabase project is LOCKED to `qwaehqsmodekbgvnaavz`.
#   2. Only the two NEXT_PUBLIC_* variables below may ever ship to the browser.
#   3. Service-role keys, database URLs and handoff secrets must NEVER be
#      placed in any NEXT_PUBLIC_* variable. The env validator refuses to boot
#      (and the test suite fails) if such a variable is detected.
# ----------------------------------------------------------------------------

# --- Browser-safe (public) -------------------------------------------------
# LOCKED — the env validator throws if this is changed to any other project.
NEXT_PUBLIC_SUPABASE_URL="https://qwaehqsmodekbgvnaavz.supabase.co"

# Public anon (publishable) key of project qwaehqsmodekbgvnaavz.
# Get it from: Supabase Dashboard → Project Settings → API → anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="PASTE_ANON_KEY_HERE"

# --- Server-only (NEVER prefix these with NEXT_PUBLIC_) ---------------------
# Service-role key — bypasses RLS. Server-side code only.
SUPABASE_SERVICE_ROLE_KEY="PASTE_SERVICE_ROLE_KEY_HERE"

# Postgres connection string of the SAME project (used by Drizzle ORM and by
# the read-only schema audit in scripts/audit-schema.ts). Use the pooled
# connection string from Supabase Dashboard → Project Settings → Database.
SUPABASE_DB_URL="postgresql://postgres.qwaehqsmodekbgvnaavz:PASTE_DB_PASSWORD_HERE@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Shared secret used to sign template handoff links (template_handoffs).
TEMPLATE_HANDOFF_SECRET="PASTE_RANDOM_SECRET_HERE"
